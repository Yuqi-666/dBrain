{
  "extends": "@workspace/typescript-config/react-library.json",
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@workspace/interfaces": [
        "../interfaces/src"
      ],
      "@workspace/interfaces/*": [
        "../interfaces/src/*"
      ],
      "@workspace/store": [
        "../store/src"
      ],
      "@workspace/store/*": [
        "../store/src/*"
      ],
      "@workspace/ui/*": [
        "../ui/src/*"
      ],
      "@workspace/utils/*": [
        "../utils/src/*"
      ],
      "@workspace/utils": [
        "../utils/src"
      ],
      "@workspace/hooks/*": [
        "../hooks/src/*"
      ],
      "@workspace/hooks": [
        "../hooks/src"
      ],
      "@workspace/api-client": [
        "../api-client/src"
      ],
      "@workspace/api-client/*": [
        "../api-client/src/*"
      ],
      "@workspace/services": [
        "../services/src"
      ],
      "@workspace/services/*": [
        "../services/src/*"
      ],
      "@workspace/adapter-front": [
        "../../backend/adapter-front/src"
      ],
      "@workspace/adapter-front/*": [
        "../../backend/adapter-front/src/*"
      ],
      "@workspace/domain": [
        "../../backend/domain/src"
      ],
      "@workspace/domain/*": [
        "../../backend/domain/src/*"
      ],
      "@workspace/infrastructure": [
        "../../backend/infrastructure/src"
      ],
      "@workspace/infrastructure/*": [
        "../../backend/infrastructure/src/*"
      ],
      "@workspace/adapter-back": [
        "../../backend/adapter-back/src"
      ],
      "@workspace/adapter-back/*": [
        "../../backend/adapter-back/src/*"
      ],
      "@workspace/application": [
        "../../backend/application/src"
      ],
      "@workspace/application/*": [
        "../../backend/application/src/*"
      ]
    }
  },
  "include": [
    "src"
  ],
  "exclude": [
    "node_modules",
    "dist"
  ]
}
