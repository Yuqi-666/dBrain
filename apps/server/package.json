{
  "name": "server",
  "version": "0.0.1",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "dev:pb": "../../pb/pocketbase serve",
    "build": "tsc --noEmit",
    "start": "node dist/index.js",
    "lint": "eslint",
    "format": "prettier --write \"**/*.{ts,tsx}\"",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@workspace/adapter-front": "workspace:*",
    "@workspace/adapter-tauri": "workspace:*",
    "@workspace/application": "workspace:*",
    "@workspace/domain": "workspace:*",
    "@workspace/infrastructure": "workspace:*",
    "@workspace/interfaces": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^25.1.0",
    "@workspace/eslint-config": "workspace:^",
    "@workspace/typescript-config": "workspace:*",
    "concurrently": "^9.0.0",
    "eslint": "^9.39.2",
    "tsx": "^4.19.0",
    "typescript": "^5.9.3"
  }
}
