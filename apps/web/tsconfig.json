{
  "extends": "@workspace/typescript-config/nextjs.json",
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@/*": ["./*"],
      "@workspace/editor/*": ["../../packages/editor/*"],
      "@workspace/ui/*": ["../../packages/ui/src/*"],
      "@workspace/store": ["../../packages/store/src"],
      "@workspace/store/*": ["../../packages/store/src/*"],
      "@workspace/graph": ["../../packages/graph/src"],
      "@workspace/graph/*": ["../../packages/graph/src/*"],
      "@workspace/interfaces": ["../../packages/interfaces/src"],
      "@workspace/interfaces/*": ["../../packages/interfaces/src/*"],
      "@workspace/dev": ["../../packages/dev/src"],
      "@workspace/dev/*": ["../../packages/dev/src/*"]
    },
    "plugins": [
      {
        "name": "next"
      }
    ]
  },
  "include": [
    "next-env.d.ts",
    "next.config.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}