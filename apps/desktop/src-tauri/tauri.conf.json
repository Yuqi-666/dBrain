{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "dBrain",
  "version": "0.1.0",
  "identifier": "cn.dbrain.desktop",
  "build": {
    "beforeDevCommand": "pnpm runtime:prepare && pnpm dev",
    "beforeBuildCommand": "pnpm runtime:prepare && pnpm build",
    "devUrl": "http://localhost:3002",
    "frontendDist": "../out"
  },
  "app": {
    "windows": [
      {
        "title": "dBrain",
        "width": 1280,
        "height": 800,
        "resizable": true,
        "fullscreen": false,
        "minWidth": 900,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": null
    },
    "withGlobalTauri": true
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "runtime/": "runtime/"
    },
    "linux": {
      "rpm": {
        "compression": {
          "type": "zstd",
          "level": 3
        }
      },
      "appimage": {
        "bundleMediaFramework": true
      }
    }
  }
}
