{
  "extends": "@workspace/typescript-config/react-library.json",
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@workspace/editor/*": [
        "./*"
      ]
    }
  },
  "include": [
    "next-env.d.ts",
