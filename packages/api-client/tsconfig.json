{
  "extends": "@workspace/typescript-config/react-library.json",
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@workspace/api-client": [
        "../api-client/src"
      ],
      "@workspace/api-client/*": [
        "../api-client/src/*"
      ],
      "@workspace/interfaces": [
        "../interfaces/src"
      ],
      "@workspace/interfaces/*": [
        "../interfaces/src/*"
      ],
      "@workspace/store": [
        "../store/src"
      ],
      "@workspace/store/*": [
        "../store/src/*"
      ],
      "@workspace/adapter-front": [
        "../../backend/adapter-front/src"
      ],
      "@workspace/adapter-front/*": [
        "../../backend/adapter-front/src/*"
      ]
    }
  },
  "include": [
    "src/**/*"
  ],
  "exclude": [
    "node_modules"
  ]
}
