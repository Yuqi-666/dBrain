{
  "extends": "@workspace/typescript-config/react-library.json",
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@workspace/ui/*": [
        "./src/*"
      ],
      "@workspace/store": [
        "../store/src"
      ],
      "@workspace/store/*": [
        "../store/src/*"
      ],
      "@workspace/editor": [
        "../editor/src"
      ],
      "@workspace/editor/*": [
        "../editor/src/*"
      ],
      "@workspace/hooks": [
        "../hooks/src"
      ],
      "@workspace/hooks/*": [
        "../hooks/src/*"
      ],
      "@workspace/interfaces": [
        "../interfaces/src"
      ],
      "@workspace/interfaces/*": [
        "../interfaces/src/*"
      ]
    }
  },
  "include": [
    "."
  ],
  "exclude": [
    "node_modules",
    "dist"
  ]
}
