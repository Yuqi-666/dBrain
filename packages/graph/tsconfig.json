{
  "extends": "@workspace/typescript-config/react-library.json",
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@workspace/interfaces": ["../interfaces/src"],
      "@workspace/interfaces/*": ["../interfaces/src/*"],
      "@workspace/store": ["../store/src"],
      "@workspace/store/*": ["../store/src/*"],
      "@workspace/ui/*": ["../ui/src/*"],
      "@workspace/utils/*": ["../utils/src/*"],
      "@workspace/utils": ["../utils/src"],
      "@workspace/graph/*": ["./src/*"],
      "@workspace/graph": ["./src"]
    }
  },
  "include": ["src"],
  "exclude": ["node_modules", "dist"]
}