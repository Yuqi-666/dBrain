{
  "extends": "@workspace/typescript-config/react-library.json",
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@workspace/interfaces": [
        "../interfaces/src"
      ],
      "@workspace/interfaces/*": [
        "../interfaces/src/*"
      ],
      "@workspace/store": [
        "../store/src"
      ],
      "@workspace/store/*": [
        "../store/src/*"
      ],
      "@workspace/ui/*": [
        "../ui/src/*"
      ],
      "@workspace/utils/*": [
        "../utils/src/*"
      ],
      "@workspace/utils": [
        "../utils/src"
      ],
      "@workspace/hooks/*": [
        "../hooks/src/*"
      ],
      "@workspace/hooks": [
        "../hooks/src"
      ],
      "@workspace/graph/*": [
        "./src/*"
      ],
      "@workspace/graph": [
        "./src"
      ],
      "@workspace/api-client": [
        "../api-client/src"
      ],
      "@workspace/api-client/*": [
        "../api-client/src/*"
      ]
    }
  },
  "include": [
    "src"
  ],
  "exclude": [
    "node_modules",
    "dist"
  ]
}
