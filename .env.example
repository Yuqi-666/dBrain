# Copy this file to `.env` before starting anything:
#
#     cp .env.example .env
#
# `.env` is read by `pnpm dev:full` and by `docker compose` run from this
# directory, and it is the single source of truth for the PocketBase operator
# account. Both refuse to start without it (the container also refuses to render
# without DBRAIN_ADMIN_EMAIL). `.env` is gitignored — never commit real values.

# --- PocketBase operator account (required) --------------------------------
# The only credential that can open the PocketBase Dashboard. The application
# itself never uses it: user identity is the `users` collection, and the API
# reaches PocketBase with each request's end-user token. It is required anyway,
# so a machine never ends up with PocketBase's unusable placeholder account.
DBRAIN_ADMIN_EMAIL=
DBRAIN_ADMIN_PASSWORD=
# Preferred over DBRAIN_ADMIN_PASSWORD for a deployment with mounted secrets: a
# file holding only the password, which keeps it out of the shell history and out
# of `docker inspect`. `pnpm dev:full` resolves a relative path against this
# repository root; inside a container it must be a path the container can read
# (e.g. a mounted /run/secrets/... file), and its trailing newline is trimmed.
#   printf %s "$(openssl rand -base64 24)" > .pb-admin-password
# DBRAIN_ADMIN_PASSWORD_FILE=.pb-admin-password

# --- Docker Compose only (pnpm dev:full ignores these) ---------------------
# Interface and port the gateway publishes; keep it on loopback and put a TLS
# proxy in front for anything reachable from outside.
DBRAIN_BIND_HOST=127.0.0.1
DBRAIN_PORT=3000
# Leave empty unless your proxy rewrites the `Host` header (an extra CDN hop, or
# `proxy_set_header Host $proxy_host`). The bundled nginx forwards the original
# `Host`, so the default is already correct — and it must stay empty locally,
# where it would be inert anyway. When set it must equal the browser's exact
# `Origin` (scheme, host, non-default port; browsers omit `:443`), because it
# replaces rather than extends the usual rule. An empty value behaves as unset.
DBRAIN_PUBLIC_ORIGIN=
