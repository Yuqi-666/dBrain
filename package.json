{
  "name": "dBrain",
  "private": true,
  "scripts": {
    "build": "pnpm --filter server build && pnpm --filter web build",
    "dev": "node scripts/dev-run.mjs",
    "dev:remote": "node scripts/dev-run.mjs --remote",
    "pb:admin": "node scripts/dev-pocketbase-admin.mjs",
    "lint": "pnpm -r --no-bail --workspace-concurrency=2 --if-present run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "check-types": "pnpm -r --no-bail --workspace-concurrency=2 --if-present run typecheck",
    "dev:desktop": "pnpm --filter desktop desktop:dev",
    "build:desktop": "pnpm --filter desktop desktop:build",
    "release:check": "node scripts/release/check.mjs",
    "release:version": "node scripts/release/version.mjs",
    "test:release": "node --experimental-strip-types --test --test-isolation=none scripts/lib/*.test.mjs scripts/release/*.test.mjs apps/server/src/desktop/security.test.ts apps/server/src/origin.test.ts backend/application/src/commands/file/hls-playlist.test.ts backend/infrastructure/src/database/request-scope.test.ts backend/infrastructure/src/storage/file-address.test.ts backend/infrastructure/src/storage/file-upload-sessions.test.ts backend/infrastructure/src/storage/multipart-envelope.test.ts apps/server/src/desktop/upgrade-backup.test.ts",
    "smoke:server": "node scripts/release/server-smoke.mjs",
    "lint:gate": "node scripts/release/lint-gate.mjs"
  },
  "devDependencies": {
    "@workspace/eslint-config": "workspace:*",
    "@workspace/typescript-config": "workspace:*",
    "concurrently": "^9.0.0",
    "prettier": "^3.7.4",
    "turbo": "^2.9.6",
    "typescript": "5.9.2"
  },
  "packageManager": "pnpm@9.0.0",
  "engines": {
    "node": ">=22"
  },
  "license": "UNLICENSED"
}
