[Unit]
Description=dBrain main automatic deployment
Wants=network-online.target
After=network-online.target docker.service

[Service]
Type=oneshot
User=lyq
Environment=HOME=/home/lyq
ExecStart=/usr/local/libexec/dbrain-auto-deploy
TimeoutStartSec=45min
TimeoutStopSec=5min
KillMode=control-group
UMask=0077
