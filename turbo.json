{
  "$schema": "https://v2-9-6.turborepo.dev/schema.json",
  "ui": "tui",
  "globalEnv": [
    "NODE_ENV",
    "NEXT_PUBLIC_DBRAIN_PLATFORM",
    "DBRAIN_UPLOAD_DIR",
    "DBRAIN_PB_INTERNAL_SECRET",
    "FFMPEG_PATH",
    "YT_DLP_PATH",
    "DBRAIN_MEDIA_IMPORT_DIR",
    "DBRAIN_MEDIA_COOKIE_SECRET",
    "MEDIA_COOKIE_SECRET",
    "DBRAIN_DESKTOP",
    "DBRAIN_LOCAL_MODE",
    "LOCALAPPDATA",
    "PROGRAMFILES",
    "PROGRAMFILES(X86)",
    "PROGRAMW6432",
    "APPDATA",
    "USERPROFILE"
  ],
  "tasks": {
    "build": {
      "dependsOn": [
        "^build"
      ],
      "inputs": [
        "$TURBO_DEFAULT$",
        ".env*"
      ],
      "outputs": [
        ".next/**",
        "!.next/cache/**",
        "out/**",
        "dist/**"
      ]
    },
    "lint": {},
    "typecheck": {},
    "dev": {
      "cache": false,
      "persistent": true
    }
  },
}
