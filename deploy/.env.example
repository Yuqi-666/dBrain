# Copy this file to `.env` next to the compose files before `docker compose up`;
# the stack refuses to start without the operator account below. This is the
# template for a self-hosted deployment (the release ships it as `.env.example`);
# a checkout uses the repository-root `.env.example` instead.
DBRAIN_VERSION=0.1.9
DBRAIN_IMAGE_PREFIX=ghcr.io/yuqi-666/dbrain
DBRAIN_BIND_HOST=127.0.0.1
DBRAIN_PORT=3000
# The separate updater container checks successful main candidates every 15 seconds.
# Keep false until the updater has been installed with compose.updater.yml.
DBRAIN_AUTO_UPDATE=false
# A GitHub token raises the API limit of that check from 60 to 5000 requests per
# hour. A token for this public repository needs no scope. Leave it empty only
# when the updater may wait for the hourly reset.
# DBRAIN_GITHUB_TOKEN=
# The absolute path of this directory on the host. The updater runs Compose in a
# container that mounts this directory at /deployment. It reads the host path
# from the mount table of that container and passes it as the Compose project
# directory. Set this only when that detection has no answer. A relative value
# is refused.
# DBRAIN_DEPLOYMENT_DIR=/opt/dbrain
# Usually leave empty: the bundled nginx forwards the original `Host`, so the API
# already admits the browser's `Origin`. Set it only if a proxy in front rewrites
# that header, and then to the browser's exact origin — scheme, host, non-default
# port, no trailing slash (browsers omit `:443`), e.g. https://dbrain.example.com.
DBRAIN_PUBLIC_ORIGIN=
# Where the API spools the chunks of a large upload before it stores the
# assembled file. Leave empty to use the container's temp directory; set it to a
# mounted path with room for one upload in flight (up to 2 GiB) when the
# container filesystem is small, e.g. /var/lib/dbrain/uploads.
DBRAIN_UPLOAD_DIR=
# --- Storage policy -------------------------------------------------------
# Both the API and PocketBase read these values, so keep the server and the
# PocketBase service equal (docker-compose.yml passes both from here).
# Sizes are whole bytes; a suffix is not accepted. Leave a value empty to use the
# built-in default shown after it.
#
# Total bytes one user may store, counting every file they uploaded and every
# derived artifact (PDF cover, HLS segment). 0 disables the total quota.
# Default: 10737418240 (10 GiB)
DBRAIN_STORAGE_USER_QUOTA_BYTES=
# Largest single file per media category. Defaults: image 33554432 (32 MiB),
# video 2147483648 (2 GiB), audio 536870912 (512 MiB), pdf 536870912 (512 MiB),
# other 268435456 (256 MiB).
DBRAIN_STORAGE_MAX_IMAGE_BYTES=
DBRAIN_STORAGE_MAX_VIDEO_BYTES=
DBRAIN_STORAGE_MAX_AUDIO_BYTES=
DBRAIN_STORAGE_MAX_PDF_BYTES=
DBRAIN_STORAGE_MAX_OTHER_BYTES=
# PocketBase Dashboard / operator account (required). The container upserts it on
# every start, so the password always matches this value; generate one with
# `openssl rand -base64 24`. Prefer DBRAIN_ADMIN_PASSWORD_FILE (a mounted secret
# file) over DBRAIN_ADMIN_PASSWORD. The application itself never uses this
# account; it only decides who can open the Dashboard.
DBRAIN_ADMIN_EMAIL=
DBRAIN_ADMIN_PASSWORD=
DBRAIN_ADMIN_PASSWORD_FILE=
